# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent tooling (local)
/.opencode/
/.agents/
/opencode.json
/skills-lock.json

# Dependencies (regenerable via npm install)
node_modules/
.opencode/node_modules/
# Session memory (machine-local, regenerable)
# Recovery state files (auto-generated, machine-local)
docs/state/*.json
docs/state/_archive/
# Auto-generated instinct files
docs/instincts/*.json
# OS junk
Thumbs.db
# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
# Timestamped backups (e.g. docs/PROJECT.md.bak.<ts> from refresh-project.js)
*.bak.*
# Hookify audit logs (machine-local, generated by .opencode/plugins/hookify.js)
.opencode/logs/
# Legacy singular-path symlinks (removed; opencode >=1.14 usa .opencode/agents/ y .agents/skills/ nativo)
/.opencode/agent
/.opencode/skill
